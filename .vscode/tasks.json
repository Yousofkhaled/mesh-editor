{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "raylib build",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}",
                "-I${workspaceFolder}/header",
                "${file}",
                "`pkg-config",
                "--libs",
                "--cflags",
                "raylib`",
                "-o",
                "${workspaceRoot}/run",
                "-std=c++11"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}